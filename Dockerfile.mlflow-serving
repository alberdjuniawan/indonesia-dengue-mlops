FROM python:3.12-slim

WORKDIR /opt/mlflow

RUN apt-get update && apt-get install --no-install-recommends -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pin numpy<2.4 for x86_64 v1 CPU compatibility (matching Dockerfile & Dockerfile.mlflow)
RUN pip install --no-cache-dir \
    "mlflow==3.17.0" \
    "cloudpickle==3.1.2" \
    "numpy<2.4" \
    "pandas" \
    "scikit-learn"

COPY models/mlflow_serving_model /opt/ml/model

ENV MLFLOW_DISABLE_AGENT_HINT=1

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/ping || exit 1

CMD ["mlflow", "models", "serve", "-m", "/opt/ml/model", "--host", "0.0.0.0", "--port", "8080", "--env-manager", "local"]
